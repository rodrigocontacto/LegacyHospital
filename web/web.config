<?xml version="1.0" encoding="UTF-8"?>
<!--
    IIS configuration for the LegacyHospital site (root: /web).

    The <asp> section is locked at server level by default, so ASP
    settings are NOT here (tools/run-local.ps1 sets them for IIS Express).

    Do not add <system.web><compilation debug="true"/>: Visual Studio offers
    it when the site is started with F5. It is an ASP.NET setting, useless
    for Classic ASP, and scanners report it as debug mode enabled.
-->
<configuration>
  <system.webServer>

    <!-- Unhandled errors: generic page, never IIS/ASP details.
         500.100 is the ASP script error; Server.GetLastError() in
         error.asp reads it.
         PassThrough: pages that set their own status (404 in
         patient.asp, 400 for invalid IDs) keep their generic body.
         Empty error responses still get error.asp. -->
    <httpErrors errorMode="Custom" existingResponse="PassThrough">
      <remove statusCode="500" subStatusCode="-1" />
      <error statusCode="500" subStatusCode="100" path="/error.asp" responseMode="ExecuteURL" />
      <error statusCode="500" path="/error.asp" responseMode="ExecuteURL" />
    </httpErrors>

    <security>
      <!-- removeServerHeader: hide "Server: Microsoft-IIS/10.0" -->
      <requestFiltering removeServerHeader="true">
        <!-- Include files are never requested directly. -->
        <hiddenSegments>
          <add segment="includes" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>

    <!-- F-02: ASP cannot set attributes on its own session cookie, so URL
         Rewrite adds them. The rules only match the exact format ASP emits
         ("ASPSESSIONIDxxxxxxxx=value; path=/"); cookies written by the app
         (core/http.asp) already carry their attributes and are left alone.
         SameSite=Lax (not Strict) so links from e-mail keep the session.
         Requires the URL Rewrite module: built into IIS Express; on full
         IIS install it first, or this section returns 500.19. -->
    <rewrite>
      <outboundRules>
        <rule name="ASP session cookie: HttpOnly and SameSite">
          <match serverVariable="RESPONSE_Set_Cookie" pattern="^(ASPSESSIONID[A-Z]{8}=[^;]+; path=/)$" />
          <action type="Rewrite" value="{R:1}; HttpOnly; SameSite=Lax" />
        </rule>
        <rule name="ASP session cookie: Secure under HTTPS">
          <match serverVariable="RESPONSE_Set_Cookie" pattern="^(ASPSESSIONID[A-Z]{8}=[^;]+; path=/; HttpOnly; SameSite=Lax)$" />
          <conditions>
            <add input="{HTTPS}" pattern="^on$" />
          </conditions>
          <action type="Rewrite" value="{R:1}; Secure" />
        </rule>
      </outboundRules>
    </rewrite>

    <defaultDocument>
      <files>
        <clear />
        <add value="login.asp" />
      </files>
    </defaultDocument>

  </system.webServer>
</configuration>
