<?xml version="1.0" encoding="UTF-8"?>
<!--
    IIS configuration for the LegacyHospital site (root: /web).

    The <asp> section is locked at server level by default, so ASP
    settings are NOT here (tools/run-local.ps1 sets them for IIS Express).

    Do not add <system.web><compilation debug="true"/>: Visual Studio offers
    it when the site is started with F5. It is an ASP.NET setting, useless
    for Classic ASP, and scanners report it as debug mode enabled.
-->
<configuration>
  <system.webServer>

    <!-- Unhandled errors: generic page, never IIS/ASP details.
         500.100 is the ASP script error; Server.GetLastError() in
         error.asp reads it.
         PassThrough: pages that set their own status (404 in
         patient.asp, 400 for invalid IDs) keep their generic body.
         Empty error responses still get error.asp. -->
    <httpErrors errorMode="Custom" existingResponse="PassThrough">
      <remove statusCode="500" subStatusCode="-1" />
      <error statusCode="500" subStatusCode="100" path="/error.asp" responseMode="ExecuteURL" />
      <error statusCode="500" path="/error.asp" responseMode="ExecuteURL" />
    </httpErrors>

    <security>
      <!-- removeServerHeader: hide "Server: Microsoft-IIS/10.0" -->
      <requestFiltering removeServerHeader="true">
        <!-- Include files are never requested directly. -->
        <hiddenSegments>
          <add segment="includes" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>

    <!-- F-02: ASP cannot set attributes on its own session cookie, so URL
         Rewrite adds them. The rules only match the exact format ASP emits
         ("ASPSESSIONIDxxxxxxxx=value; path=/"); cookies written by the app
         (core/http.asp) already carry their attributes and are left alone.
         SameSite=Lax (not Strict) so links from e-mail keep the session.
         Requires the URL Rewrite module: built into IIS Express; on full
         IIS install it first, or this section returns 500.19. -->
    <rewrite>
      <!-- F-03: plain HTTP is only a 301 to the same URL over HTTPS, so
           passwords, session cookies and patient data never travel in
           clear text. The map turns the HTTP port into the HTTPS port
           suffix: 8080 (tools/run-local.ps1) -> :44300; any other port
           (80 in production) -> "" (default 443).
           The host comes from SERVER_NAME (the Host header): bind the
           site to its host name in production (run-local binds only
           "localhost"), so a forged Host header never reaches it. -->
      <rewriteMaps>
        <rewriteMap name="HttpsPortSuffix" defaultValue="">
          <add key="8080" value=":44300" />
        </rewriteMap>
      </rewriteMaps>
      <rules>
        <rule name="HTTP to HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
          </conditions>
          <action type="Redirect" url="https://{SERVER_NAME}{HttpsPortSuffix:{SERVER_PORT}}/{R:1}" redirectType="Permanent" appendQueryString="true" />
        </rule>
      </rules>
      <!-- ASP emits "ASPSESSIONIDxxxxxxxx=value; path=/", or with
           <session keepSessionIdSecure="true"> (set by run-local, F-03)
           "ASPSESSIONIDxxxxxxxx=value; secure; path=/". Both forms are
           matched; anything else is left alone. -->
      <outboundRules>
        <rule name="ASP session cookie: HttpOnly, SameSite, Secure (HTTPS)" stopProcessing="true">
          <match serverVariable="RESPONSE_Set_Cookie" pattern="^(ASPSESSIONID[A-Z]{8}=[^;]+)(; secure)?; path=/$" />
          <conditions>
            <add input="{HTTPS}" pattern="^on$" />
          </conditions>
          <action type="Rewrite" value="{R:1}; path=/; HttpOnly; SameSite=Lax; Secure" />
        </rule>
        <rule name="ASP session cookie: HttpOnly, SameSite (HTTP)" stopProcessing="true">
          <match serverVariable="RESPONSE_Set_Cookie" pattern="^(ASPSESSIONID[A-Z]{8}=[^;]+)(; secure)?; path=/$" />
          <action type="Rewrite" value="{R:1}; path=/; HttpOnly; SameSite=Lax" />
        </rule>
      </outboundRules>
    </rewrite>

    <defaultDocument>
      <files>
        <clear />
        <add value="login.asp" />
      </files>
    </defaultDocument>

  </system.webServer>
</configuration>
